# Copy to ~/.kraken_credentials (chmod 600) or a local .env, fill in real values.
# NEVER commit real keys. No spaces around '=' or the shell exports empty values.

# Spot (primary)
export KRAKEN_API_KEY=
export KRAKEN_API_SECRET=

# Futures (separate keys — optional, secondary/unused path)
export KRAKEN_FUTURES_API_KEY=
export KRAKEN_FUTURES_API_SECRET=

# Optional: override spot base URL (defaults to https://api.kraken.com)
# export KRAKEN_API_BASE=https://api.kraken.com
